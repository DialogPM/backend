# Dialog server configuration. Copy to .env and adjust.
# docker compose reads this file automatically; the server itself reads the environment.

# --- Required ------------------------------------------------------------------

# Random secret, at least 32 characters (used for fake pre-login salts and phone code
# MACs). Generate with: openssl rand -base64 48
CHATAPP_SERVER_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# MySQL DSN (go-sql-driver format). parseTime/utf8mb4/UTC are forced by the server.
# With docker compose the host is "mysql".
CHATAPP_MYSQL_DSN=chatapp:chatapp-db-password@tcp(mysql:3306)/chatapp

# MinIO / S3 credentials (with docker compose these also create the MinIO root user).
CHATAPP_MINIO_ACCESS_KEY=chatapp-minio
CHATAPP_MINIO_SECRET_KEY=change-me-minio-secret

# --- Optional (defaults shown) -----------------------------------------------------

CHATAPP_LISTEN_ADDR=:8080
CHATAPP_MINIO_ENDPOINT=minio:9000
CHATAPP_MINIO_BUCKET=chatapp-attachments
CHATAPP_MINIO_USE_SSL=false
# CHATAPP_MINIO_REGION=

CHATAPP_SERVER_NAME=Dialog
CHATAPP_REGISTRATION_ENABLED=true
CHATAPP_MAX_DEVICES=6
CHATAPP_MAX_GROUP_MEMBERS=256
# 100 MiB
CHATAPP_ATTACHMENT_MAX_BYTES=104857600
CHATAPP_ATTACHMENT_TTL_DAYS=30
CHATAPP_MESSAGE_TTL_DAYS=30
# 1 GiB
CHATAPP_VAULT_QUOTA_BYTES=1073741824

# SMS provider for phone verification: log (prints codes to the server log), twilio, none.
CHATAPP_SMS_PROVIDER=log
# CHATAPP_TWILIO_ACCOUNT_SID=
# CHATAPP_TWILIO_AUTH_TOKEN=
# CHATAPP_TWILIO_FROM=+15550000000

# Mobile push notifications (Firebase Cloud Messaging HTTP v1; iOS through FCM's APNs
# integration). Path to the Firebase service account JSON *inside the container*; leave
# unset to disable push (GET /v1/info then reports "push_enabled": false). With docker
# compose, put the file in ./secrets/ (mounted read-only at /run/secrets/chatapp) and make it
# readable by UID 65532. See docs/PUSH-SETUP.md.
# CHATAPP_FCM_CREDENTIALS_FILE=/run/secrets/chatapp/fcm-service-account.json

# Direct APNs VoIP (PushKit) pushes of incoming calls to iOS (optional; without them iOS
# calls arrive as a normal "Incoming call" alert through FCM). The .p8 auth key from the
# Apple Developer account (Keys -> Apple Push Notifications service), its Key ID and the
# Team ID. CHATAPP_APNS_SANDBOX=true for apps signed for development (Xcode / flutter run);
# false (default) for TestFlight and App Store builds. See docs/PUSH-SETUP.md.
# CHATAPP_APNS_KEY_FILE=/run/secrets/chatapp/apns-auth-key.p8
# CHATAPP_APNS_KEY_ID=XXXXXXXXXX
# CHATAPP_APNS_TEAM_ID=XXXXXXXXXX
# CHATAPP_APNS_TOPIC=pm.dialog.chat.voip
# CHATAPP_APNS_SANDBOX=false

# Header set by your reverse proxy with the client IP (used for per-IP rate limits).
# Leave empty when the server is reached directly. Only set it when the server is not
# reachable except through the proxy, otherwise clients can spoof it.
CHATAPP_TRUSTED_PROXY_HEADER=

# debug, info, warn, error
CHATAPP_LOG_LEVEL=info
# text or json
CHATAPP_LOG_FORMAT=text

# --- docker compose only -----------------------------------------------------------
# Host address of the MinIO web console.
# CHATAPP_MINIO_CONSOLE_PUBLISH=127.0.0.1:9001
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=chatapp
MYSQL_USER=chatapp
MYSQL_PASSWORD=chatapp-db-password
# Host directory mounted read-only at /run/secrets/chatapp (FCM credentials).
# CHATAPP_SECRETS_DIR=./secrets
# Host port the server is published on (bind to 127.0.0.1 behind a local reverse proxy).
CHATAPP_PUBLISH=127.0.0.1:8080

# --- Admin API (optional, docs/ADMIN-API.md) -------------------------------------------
# Comma-separated Ed25519 *public* keys (standard base64, 32 bytes) of the admin app(s).
# Every /v1/admin request must be signed by one of the matching private keys, which never
# leave the admin's machine; the server holds no admin secret. Unset: the admin API is off
# and every /v1/admin/* path answers 404. Served on the normal port (behind Caddy), no new port.
# CHATAPP_ADMIN_PUBLIC_KEYS=<base64 public key>,<another base64 public key>
# JSON {"last_at": <unix ms>, "size_bytes": <n>} written by the host's backup script, shown
# in the admin overview. Path *inside the container*; mount its directory read-only (see the
# commented volume in docker-compose.yml).
# CHATAPP_BACKUP_STATUS_FILE=/run/backup-status/status.json
# Commit shown in the admin overview (otherwise read from /app/DEPLOYED_COMMIT if present).
# CHATAPP_COMMIT=

# Development/testing only: disables all rate limits.
# CHATAPP_DISABLE_RATE_LIMITS=false

# --- Voice calls (optional) ----------------------------------------------------------
# Without TURN, calls only connect when the two devices can reach each other directly.
# Start the bundled coturn with: docker compose --profile calls up -d
# CHATAPP_TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp
# Shared with coturn (static-auth-secret); generate with: openssl rand -base64 32
# CHATAPP_TURN_SECRET=
# Lifetime of the TURN credentials handed to clients (default 1 h).
# CHATAPP_TURN_TTL_SECONDS=3600
# CHATAPP_STUN_URLS=stun:chat.example.com:3478
